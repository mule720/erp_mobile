{
  "expo": {
    "name": "NetOn ERP Pro",
    "slug": "nexora-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexoraerp",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1E3A5F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexora.erp",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nexora.erp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E3A5F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.netonerppro.com/graphql/",
      "webUrl": "https://netonerppro.com",
      "eas": {
        "projectId": "nexora-erp"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Nexora ERP uses the camera to scan product barcodes and QR codes at the till."
        }
      ]
    ]
  }
}
