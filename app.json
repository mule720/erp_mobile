{
  "expo": {
    "name": "NetOn ERP Pro",
    "slug": "nexora-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexoraerp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexora.erp",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.nexora.erp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://api.netonerppro.com/graphql/",
      "webUrl": "https://netonerppro.com",
      "eas": {
        "projectId": "a39a77ff-03e7-49fe-9eb8-dde339f5470e"
      }
    },
    "plugins": [
      "./plugins/withOptionalHardware",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Nexora ERP uses the camera to scan product barcodes and QR codes at the till.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NetOn ERP Pro reads photos you choose, such as invoices, receipts and recipes.",
          "cameraPermission": "NetOn ERP Pro uses the camera to photograph invoices, receipts, recipes and products."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "owner": "chamwi"
  }
}
